<Page x:Class="FacturacionAlemana.CreateInvoicePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Crear Factura"
      Background="{DynamicResource ApplicationBackgroundBrush}">
    
    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid Background="{StaticResource AppSurface}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header arrastrable con controles de ventana -->
        <Border Grid.Row="0" Background="{StaticResource AppWhite}" Padding="8,2" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="CreateInvoiceHeader_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Crear Nueva Factura" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Minimizar -->
                    <Button x:Name="BtnMinimizeCI" Click="OnMinimizeWindowClick" ToolTip="Minimizar" Width="38" Height="26" Padding="0" Margin="8,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent">
                        <Grid>
                            <TextBlock Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF2F2F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximizar/Restaurar -->
                    <Button x:Name="BtnMaxRestoreCI" Click="OnToggleMaximizeClick" ToolTip="Maximizar/Restaurar" Width="38" Height="26" Padding="0" Margin="8,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent">
                        <Grid>
                            <TextBlock Text="▢" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF2F2F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cerrar -->
                    <Button x:Name="BtnCloseCI" Click="OnCloseWindowClick" ToolTip="Cerrar" Width="38" Height="26" Padding="0" Margin="8,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent">
                        <Grid>
                            <TextBlock Text="✕" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF2F2F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20" Orientation="Vertical">
                <!-- InfoBar / Alertas no intrusivas -->
                <Border x:Name="TopAlertsPanel" Visibility="Collapsed" Margin="0,0,0,12" Padding="10" CornerRadius="6" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock x:Name="TopAlertsTitle" Text="Revisa los campos pendientes" FontWeight="SemiBold"/>
                        <ItemsControl x:Name="TopAlertsItems"/>
                    </StackPanel>
                </Border>

                <!-- Título con botón Salir alineado a la izquierda -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="ExitButton" Content="⟵ Salir" Appearance="Secondary" Padding="18,8" Margin="0,0,12,0" Click="OnExitClick"/>
                    <TextBlock Grid.Column="1" Text="Crear Nueva Factura" FontSize="28" FontWeight="Bold" HorizontalAlignment="Left" Foreground="{StaticResource PrimaryTextBrush}"/>
                </Grid>

                <!-- BEGIN: Stepper (TabControl) -->
                <TabControl x:Name="StepsTabControl" Margin="0,0,0,10">
                    <!-- Paso 1: Emisor (Vendedor) -->
                    <TabItem Header="1. Emisor (Vendedor)">
                        <StackPanel>
                            <ui:Card Background="{StaticResource CardSurface}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Datos del Vendedor" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Nombre*:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerNameTextBox" Grid.Column="1" PlaceholderText="Nombre de la empresa" Text="Giatec GmbH"/>
                                        <TextBlock Text="Persona de Contacto:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerPersonNameTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Nombre" Text="Frank Papenheim"/>
                                        <TextBlock Text="Email:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerEmailTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="email@empresa.com" Text="info@giatec.de"/>
                                        <TextBlock Text="Teléfono:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerPhoneTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="+49 123 456789" Text="(02324) 201890"/>
                                    </Grid>
                                    <TextBlock Text="Dirección del Vendedor" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,10" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Calle línea 1:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerStreetTextBox" Grid.Column="1" PlaceholderText="Calle y número" Text="Ruhrallee 5"/>
                                        <TextBlock Text="Calle línea 2:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerStreet2TextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Complemento dirección"/>
                                        <TextBlock Text="Ciudad:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerCityTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Ciudad" Text="Hattingen"/>
                                        <TextBlock Text="Código Postal:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerPostcodeTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="12345" Text="45525"/>
                                    </Grid>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="País:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerCountryTextBox" Grid.Column="1" PlaceholderText="DE" Text="DE" TextChanged="Country_Uppercase_TextChanged" ToolTip="Código país ISO-3166-1 alfa-2 (ej.: DE, ES, FR)"/>
                                    </Grid>
                                    <TextBlock Text="Identificadores" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,10" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="VAT ID*:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerVATTextBox" Grid.Column="1" PlaceholderText="DE123456789" Text="DE162986901" LostFocus="Uppercase_OnLostFocus" ToolTip="VAT por país; debe iniciar por código (ej.: DE123456789)"/>
                                        <TextBlock Text="St.-Nr.:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="SellerTaxTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="1111/1111/1111"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </TabItem>

                    <!-- Paso 2: Receptor (Comprador) -->
                    <TabItem Header="2. Receptor (Comprador)">
                        <StackPanel>
                            <ui:Card Background="{StaticResource CardSurface}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Datos del Comprador" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Nombre*:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerNameTextBox" Grid.Column="1" PlaceholderText="Nombre empresa cliente"/>
                                        <TextBlock Text="Persona de Contacto:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerPersonNameTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Nombre"/>
                                        <TextBlock Text="Email:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerEmailTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="cliente@empresa.com" ToolTip="Formato email válido (ej.: usuario@dominio.com)"/>
                                        <TextBlock Text="Teléfono:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerPhoneTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="+49 987 654321"/>
                                    </Grid>
                                    <TextBlock Text="Dirección del Comprador" FontSize="14" FontWeight="SemiBold" Margin="0,20,0,10" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Calle:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerStreetTextBox" Grid.Column="1" PlaceholderText="Calle y número"/>
                                        <TextBlock Text="Calle 2:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerStreet2TextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Calle línea 2"/>
                                        <TextBlock Text="Ciudad:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerCityTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Ciudad"/>
                                        <TextBlock Text="Código Postal:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerPostcodeTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="12345"/>
                                    </Grid>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="País:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerCountryTextBox" Grid.Column="1" PlaceholderText="DE" TextChanged="Country_Uppercase_TextChanged" ToolTip="Código país ISO-3166-1 alfa-2 (ej.: DE, ES, FR)"/>
                                    </Grid>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="USt-ID:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerVATTextBox" Grid.Column="1" PlaceholderText="DE123456789" LostFocus="Uppercase_OnLostFocus"/>
                                    </Grid>
                                    <Grid Margin="0,15,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="E-Adresse Contacto:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                        <ui:TextBox x:Name="BuyerEmailContactTextBox" Grid.Column="1" PlaceholderText="contacto@cliente.com"/>
                                    </Grid>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </TabItem>

                    <!-- Paso 3: Líneas -->
                    <TabItem Header="3. Líneas">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:Card Background="{StaticResource CardSurface}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Productos/Servicios" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <DataGrid x:Name="ProductsDataGrid" AutoGenerateColumns="False" 
                                                  CanUserAddRows="False" CanUserDeleteRows="True" Height="200" Margin="0,0,0,15"
                                                  EnableRowVirtualization="True" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel"
                                                  KeyDown="ProductsDataGrid_KeyDown">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Pos" Binding="{Binding Pos}" Width="50"/>
                                                <DataGridTextColumn Header="Nombre" Binding="{Binding Name}" Width="*"/>
                                                <DataGridTemplateColumn Header="Descripción" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding DescripcionCompleta}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTextColumn Header="Cantidad" Binding="{Binding Cantidad, StringFormat=N2}" Width="80">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Unidad" Binding="{Binding Unit}" Width="60"/>
                                                <DataGridTextColumn Header="Precio Unitario" Binding="{Binding PrecioUnitario, StringFormat=N2}" Width="100">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTextColumn Header="Total" Binding="{Binding PrecioTotal, StringFormat=N2}" Width="100" IsReadOnly="True">
                                                    <DataGridTextColumn.ElementStyle>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="TextAlignment" Value="Right"/>
                                                        </Style>
                                                    </DataGridTextColumn.ElementStyle>
                                                </DataGridTextColumn>
                                                <DataGridTemplateColumn Header="Acciones" Width="180">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                                <ui:Button Content="⬆" Padding="6,2" Margin="2" Click="MoveUp_Click"/>
                                                                <ui:Button Content="⬇" Padding="6,2" Margin="2" Click="MoveDown_Click"/>
                                                                <ui:Button Content="⎘" Padding="6,2" Margin="2" Click="Duplicate_Click"/>
                                                                <ui:Button Content="🗑" Padding="6,2" Margin="2" Click="Delete_Click"/>
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="Detalles" Width="100">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <ui:Button Content="Editar" Click="EditProductDetails_Click" Padding="5,2" Margin="2"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Agregar Producto" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox x:Name="ProductDescTextBox" PlaceholderText="Nombre del Producto" FontSize="12" KeyDown="AddProduct_Enter"/>
                                            <ui:TextBox x:Name="ProductQtyTextBox" Grid.Column="1" PlaceholderText="Cant." Margin="10,0,0,0" FontSize="12" PreviewTextInput="OnlyNumeric_PreviewTextInput" DataObject.Pasting="OnlyNumeric_Pasting" LostFocus="FormatTwoDecimals_LostFocus" KeyDown="AddProduct_Enter"/>
                                            <ui:TextBox x:Name="ProductPriceTextBox" Grid.Column="2" PlaceholderText="Precio" Margin="10,0,0,0" FontSize="12" PreviewTextInput="OnlyNumeric_PreviewTextInput" DataObject.Pasting="OnlyNumeric_Pasting" LostFocus="FormatTwoDecimals_LostFocus" KeyDown="AddProduct_Enter"/>
                                            <ui:Button x:Name="AddProductButton" Content="✓ Agregar" Grid.Column="3" Click="OnAddProductClick" Margin="10,0,0,0" Padding="15,5"/>
                                        </Grid>
                                    </StackPanel>
                                </ui:Card>

                                <ui:Card Background="{StaticResource CardSurface}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Resumen de Factura" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <Border BorderBrush="{StaticResource DividerBrush}" 
                                                BorderThickness="0,1,0,0" Padding="0,10,0,10">
                                            <StackPanel>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Subtotal:" FontSize="13"/>
                                                    <TextBlock x:Name="SubtotalTextBlock" Grid.Column="1" FontSize="13" Text="€0,00" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Grid Margin="0,0,0,10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="Impuestos (IVA):" FontSize="13"/>
                                                    <TextBlock x:Name="TaxesTextBlock" Grid.Column="1" FontSize="13" Text="€0,00" FontWeight="SemiBold"/>
                                                </Grid>
                                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" 
                                                        BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="Total a Pagar:" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock x:Name="TotalTextBlock" Grid.Column="1" FontSize="14" Text="€0,00" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}"/>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Paso 4: Impuestos y Pagos -->
                    <TabItem Header="4. Impuestos y Pagos">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <ui:Card Background="{StaticResource CardSurface}" Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock Text="Datos de la Factura" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15" Foreground="{StaticResource PrimaryTextBrush}"/>
                                        <Grid Margin="0,0,0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Número de Factura*:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <ui:TextBox x:Name="InvoiceNumberTextBox" Grid.Column="1" PlaceholderText="INV-001"/>
                                            <TextBlock Text="Referencia del Comprador (BT-10)*:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <ui:TextBox x:Name="BuyerReferenceTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="REF-12345 (Obligatorio)" ToolTip="Obligatorio según XRechnung (BR-DE-15)"/>
                                            <TextBlock Text="Fecha:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <DatePicker x:Name="IssueDatePicker" Grid.Row="2" Grid.Column="1"/>
                                            <TextBlock Text="Fecha de Vencimiento:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <DatePicker x:Name="DueDatePicker" Grid.Row="3" Grid.Column="1"/>
                                            <TextBlock Text="Fecha de Entrega:" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                            <DatePicker x:Name="DeliveryDatePicker" Grid.Row="4" Grid.Column="1"/>
                                            <TextBlock Text="Moneda:" Grid.Row="5" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
