<Window x:Class="FacturacionAlemana.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Previsualización de Factura" 
        Height="800" 
        Width="900"
        WindowStartupLocation="CenterOwner"
        Icon="Assets/icono.ico">
    <Grid Background="{DynamicResource ControlFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Información de la factura -->
        <ScrollViewer Grid.Row="0" Margin="20" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="PreviewPanel" Orientation="Vertical"/>
        </ScrollViewer>

        <!-- Botones -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="20" Height="50">
            <ui:Button Name="GenerarButton" 
                    Click="OnGenerarClick" 
                    Appearance="Success"
                    Content="✓ Generar PDF" 
                    Width="150" 
                    Margin="5,0"/>
            <ui:Button Name="CancelarButton" 
                    Click="OnCancelarClick" 
                    Appearance="Secondary"
                    Content="✕ Cancelar" 
                    Width="150" 
                    Margin="5,0"/>
        </StackPanel>
    </Grid>
</Window>
