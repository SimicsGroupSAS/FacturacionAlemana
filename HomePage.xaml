<Page x:Class="FacturacionAlemana.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="HomePage"
      Background="Transparent"
      RenderOptions.BitmapScalingMode="HighQuality"
      TextOptions.TextFormattingMode="Display"
      TextOptions.TextRenderingMode="ClearType"
      SnapsToDevicePixels="True"
      UseLayoutRounding="True"
      FontFamily="Segoe UI Variable, Segoe UI">

    <Page.Resources>
        <!-- Easing function para animaciones suaves -->
        <CubicEase x:Key="CubicEase" EasingMode="EaseOut" />

        <!-- Paleta: usar recursos globales en App.xaml -->
        <!-- Semi-transparent white para IconHolder hover -->
        <SolidColorBrush x:Key="SemiTransparentWhite" Color="#44FFFFFF" />

        <!-- Focus visual accesible (outline) -->
        <Style x:Key="AccessibleFocusVisual" TargetType="Control">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle Stroke="#0E8E3A" StrokeThickness="2" RadiusX="8" RadiusY="8" Margin="2" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Usar estilos globales (importados en App.xaml) -->
    </Page.Resources>

    <!-- Nuevo layout a pantalla completa: header + contenido -->
    <DockPanel LastChildFill="True">
        <!-- Header (arrastrable) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource AppWhite}" Padding="14" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Arrow">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Logo + app title: limitar ancho y permitir ellipsis -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Grid.Column="0">
                    <Image x:Name="IconImg" Source="Assets/Logo-v1_2024-SIMICS-TRADING-GmbH.png" Width="40" Height="40"/>                <TextBlock x:Name="AppTitle" Text="Facturación Alemana" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="240" Foreground="{StaticResource PrimaryTextBrush}" />
                </StackPanel>

                <!-- Subtítulo centrado: no capturable por ratón y con recorte si falta espacio -->
                <TextBlock x:Name="Subtitle" Grid.Column="1" Text="Generador de facturas — rápido y sencillo" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"
                           Cursor="Arrow" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="520" IsHitTestVisible="False"/><!-- Zona derecha: status y controles: limitar ancho del status para que no empuje el centro -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="Listo" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,12,0"
                               TextTrimming="CharacterEllipsis" MaxWidth="220" TextWrapping="NoWrap"/>
                    
                    <!-- Selector de Idioma -->
                    <ComboBox x:Name="LanguageComboBox" Width="120" Height="28" Margin="8,0,12,0" VerticalAlignment="Center"
                              SelectionChanged="OnLanguageSelectionChanged"
                              Background="{StaticResource AppWhite}" 
                              Foreground="{StaticResource PrimaryTextBrush}"
                              BorderBrush="{StaticResource DividerBrush}"
                              BorderThickness="1"
                              Padding="8,4"
                              FontSize="12" />
                    
                    <!-- Minimizar -->
                    <Button x:Name="BtnMinimize" Click="OnMinimizeWindowClick" ToolTip="Minimizar" Width="38" Height="28" Padding="0" Margin="8,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent" FocusVisualStyle="{StaticResource AccessibleFocusVisual}">
                        <Grid>
                            <TextBlock Text="—" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF2F2F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Maximizar/Restaurar -->
                    <Button x:Name="BtnMaxRestore" Click="OnToggleMaximizeClick" ToolTip="Maximizar/Restaurar" Width="38" Height="28" Padding="0" Margin="8,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent" FocusVisualStyle="{StaticResource AccessibleFocusVisual}">
                        <Grid>
                            <TextBlock Text="▢" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF2F2F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Cerrar -->
                    <Button x:Name="BtnClose" Click="OnCloseWindowClick" ToolTip="Cerrar" Width="38" Height="28" Padding="0" Margin="8,0,0,0" Cursor="Hand"
                            Background="Transparent" BorderBrush="Transparent" FocusVisualStyle="{StaticResource AccessibleFocusVisual}">
                        <Grid>
                            <TextBlock Text="✕" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#FFF2F2F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter Property="Background" Value="#FFE8E8E8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Background="{StaticResource AppSurface}">
            <Border Background="{StaticResource CardSurface}" CornerRadius="18" Padding="18" Margin="20">
                <Border.Effect>
                    <DropShadowEffect Color="#22000000" BlurRadius="28" ShadowDepth="10" Opacity="0.36"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <!-- Área izquierda: acciones principales en 2x2 dentro de una card ligera (sin scroll) -->
                    <Grid Grid.Column="0" Margin="18" VerticalAlignment="Stretch">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card de Acciones ocupa la primera fila y estira -->
                        <Border x:Name="ActionsCard" Style="{StaticResource CardBorder}" Grid.Row="0" VerticalAlignment="Stretch" ClipToBounds="False" MinHeight="220">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="ActionsTitle" Text="Acciones" FontSize="20" FontWeight="SemiBold" Margin="4,2,0,12" Grid.Row="0" Foreground="{StaticResource PrimaryTextBrush}" />

                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>                                    <!-- Usar estilo primario para todos los botones para mantener paleta coherente -->
                                    <ui:Button x:Name="BtnLoadXml" Grid.Row="0" Grid.Column="0" Style="{StaticResource BigActionButton}" Icon="📄" Tag="📄" Content="Cargar XML" Click="OnLoadXmlClick" Margin="8"/>
                                    <ui:Button x:Name="BtnPreview" Grid.Row="0" Grid.Column="1" Style="{StaticResource BigActionButton}" Icon="👁" Tag="👁" Content="Previsualizar" Click="OnPreviewClick" Margin="8"/>
                                    <ui:Button x:Name="BtnGeneratePdf" Grid.Row="1" Grid.Column="0" Style="{StaticResource BigActionButton}" Icon="⤴️" Tag="⤴️" Content="Generar PDF" Click="OnGeneratePdfClick" Margin="8"/>
                                    <ui:Button x:Name="BtnCreateInvoice" Grid.Row="1" Grid.Column="1" Style="{StaticResource BigActionButton}" Icon="➕" Tag="➕" Content="Crear Factura" Click="OnCreateInvoiceClick" Margin="8"/>
                                </Grid>
                            </Grid>
                        </Border>                        <!-- 'Ayuda rápida' ahora aparece como un subtitulo / comentario debajo de la card de acciones -->
                        <TextBlock x:Name="QuickHelpText" Text="Ayuda rápida: carga tu XML y usa 'Previsualizar' para verificar datos. Usa 'Crear Factura' para iniciar desde cero." 
                                   Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" Opacity="0.95" MaxWidth="640" Grid.Row="1"/>
                    </Grid>

                    <!-- Área derecha: panel lateral con últimas cargas y ayuda rápida (sin scroll) -->
                    <Grid Grid.Column="1" Margin="18">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Card principal: Últimas cargas (ocupa el espacio disponible) -->
                        <Border Style="{StaticResource CardBorder}" Grid.Row="0" VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="RecentFilesTitle" Text="Últimas cargas" FontWeight="Bold" FontSize="14" Grid.Row="0" Foreground="{StaticResource PrimaryTextBrush}" />

                                <!-- ListView estirable: mostrará todos los ítems en el espacio disponible -->
                                <ListView x:Name="LvRecent" Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Stretch" />

                                <TextBlock x:Name="RecentFilesHint" Text="Haz clic en una fila para previsualizar o generar PDF rápidamente." FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,8,0,0" Grid.Row="2" />
                            </Grid>
                        </Border>

                        <!-- espacio vacío / opcional para futuros widgets debajo -->
                        <Grid Grid.Row="1" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</Page>