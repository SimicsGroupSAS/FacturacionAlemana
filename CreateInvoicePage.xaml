                                        </Grid>

                                        <Expander Header="Datos Bancarios" IsExpanded="False" Margin="0,10,0,0">
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="IBAN*:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <Grid Grid.Column="1">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ui:TextBox x:Name="IBANTextBox" Grid.Column="0" PlaceholderText="DE89370400440532013000" TextChanged="IBANTextBox_TextChanged" ToolTip="IBAN alemán (22 caracteres). Se valida mod-97."/>
                                                    <Button Grid.Column="1" Content="Copiar" Margin="6,0,0,0" Padding="10,4" Click="CopyIban_Click"/>
                                                </Grid>
                                                <TextBlock Text="BIC:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="BICTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="COBADEFFXXX" LostFocus="Uppercase_OnLostFocus"/>
                                                <TextBlock Text="Nombre de Cuenta:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="AccountNameTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Nombre Empresa"/>
                                            </Grid>
                                        </Expander>

                                        <Expander Header="Referencias de Documentos" IsExpanded="False" Margin="0,10,0,0">
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Número de Proyecto:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ProjectNumberTextBox" Grid.Column="1" PlaceholderText="Numero del Proyecto"/>
                                                <TextBlock Text="Número de Contrato:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ContractNumberTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Numero del Contrato"/>
                                                <TextBlock Text="Número de Orden:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="PurchaseOrderNumberTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Numero de Orden"/>
                                                <TextBlock Text="Número de Trabajo:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="SalesOrderNumberTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="Numero del Trabajo"/>
                                                <TextBlock Text="Concepto Pago:" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="PaymentReferenceTextBox" Grid.Row="4" Grid.Column="1" PlaceholderText="CONCEPTODELPAGODELCLIENTE"/>
                                            </Grid>
                                        </Expander>

                                        <Expander Header="Notas y Observaciones" IsExpanded="False" Margin="0,10,0,0">
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Notas Generales:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="GeneralNoteTextBox" Grid.Column="1" PlaceholderText="Zahlungsart: Überweisung" Text="Zahlungsart: Überweisung"/>
                                                <TextBlock Text="Descripción de Términos de Pago:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="PaymentTermsDescriptionTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Bitte überweisen Sie den Rechnungsbetrag in Höhe von X EUR bis zum Fälligkeitsdatum XX.XX.XXXX." Text="Bitte überweisen Sie den Rechnungsbetrag in Höhe von {Total} EUR bis zum Fälligkeitsdatum {DueDate}."/>
                                            </Grid>
                                        </Expander>

                                        <Expander Header="Notas" IsExpanded="False" Margin="0,10,0,0">
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Términos de Pago:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="NotesTextBox" Grid.Column="1" PlaceholderText="Zahlungsart: Überweisung" Text="Zahlungsart: Überweisung"/>
                                            </Grid>
                                        </Expander>

                                        <Expander Header="Detalles de Entrega" IsExpanded="False" Margin="0,10,0,0">
                                            <Grid Margin="0,10,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <TextBlock Text="Nombre de Entrega:" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToNameTextBox" Grid.Column="1" PlaceholderText="Nombre del lugar de entrega"/>
                                                <TextBlock Text="ID de Entrega:" Grid.Row="1" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToIDTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="ID del lugar"/>
                                                <TextBlock Text="Calle línea 1:" Grid.Row="2" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToLineOneTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Calle y número"/>
                                                <TextBlock Text="Calle línea 2:" Grid.Row="3" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToLineTwoTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="Complemento dirección"/>
                                                <TextBlock Text="Calle línea 3:" Grid.Row="4" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToLineThreeTextBox" Grid.Row="4" Grid.Column="1" PlaceholderText="Información adicional"/>
                                                <TextBlock Text="Ciudad:" Grid.Row="5" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToCityNameTextBox" Grid.Row="5" Grid.Column="1" PlaceholderText="Ciudad"/>
                                                <TextBlock Text="Código Postal:" Grid.Row="6" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToPostcodeCodeTextBox" Grid.Row="6" Grid.Column="1" PlaceholderText="12345"/>
                                                <TextBlock Text="País:" Grid.Row="7" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToCountryIDTextBox" Grid.Row="7" Grid.Column="1" PlaceholderText="DE" TextChanged="Country_Uppercase_TextChanged"/>
                                                <TextBlock Text="Subdivisión (Región):" Grid.Row="8" VerticalAlignment="Center" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <ui:TextBox x:Name="ShipToCountrySubDivisionNameTextBox" Grid.Row="8" Grid.Column="1" PlaceholderText="Bayern"/>
                                            </Grid>
                                        </Expander>
                                    </StackPanel>
                                </ui:Card>
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <!-- Paso 5: Resumen final y acciones -->
                    <TabItem Header="5. Resumen">
                        <StackPanel>
                            <ui:Card Background="{StaticResource CardSurface}" Margin="0,0,0,20">
                                <StackPanel>
                                    <TextBlock Text="Resumen de la factura" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" Foreground="{StaticResource PrimaryTextBrush}"/>
                                    <TextBlock Text="Verifica los datos antes de generar la factura." Opacity="0.85"/>

                                    <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,12,0,0">
                                        <StackPanel>
                                            <!-- Emisor -->
                                            <TextBlock Text="Emisor" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nombre:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=SellerNameTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VAT ID:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=SellerVATTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dirección:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                    <Run Text="{Binding Text, ElementName=SellerStreetTextBox}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Text, ElementName=SellerStreet2TextBox}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Text, ElementName=SellerPostcodeTextBox}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Text, ElementName=SellerCityTextBox}"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Text, ElementName=SellerCountryTextBox}"/>
                                                </TextBlock>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Contacto:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1">
                                                    <Run Text="{Binding Text, ElementName=SellerEmailTextBox}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Text, ElementName=SellerPhoneTextBox}"/>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Receptor -->
                                            <TextBlock Text="Receptor" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nombre:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=BuyerNameTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="VAT ID:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=BuyerVATTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Dirección:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                    <Run Text="{Binding Text, ElementName=BuyerStreetTextBox}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Text, ElementName=BuyerStreet2TextBox}"/>
                                                    <Run Text=" · "/>
                                                    <Run Text="{Binding Text, ElementName=BuyerPostcodeTextBox}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding Text, ElementName=BuyerCityTextBox}"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Text, ElementName=BuyerCountryTextBox}"/>
                                                </TextBlock>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Contacto:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1">
                                                    <Run Text="{Binding Text, ElementName=BuyerEmailTextBox}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Text, ElementName=BuyerPhoneTextBox}"/>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Factura -->
                                            <TextBlock Text="Factura" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nº de factura:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=InvoiceNumberTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Fechas:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1">
                                                    <Run Text="Emisión: "/>
                                                    <Run Text="{Binding SelectedDate, ElementName=IssueDatePicker, StringFormat={}{0:dd.MM.yyyy}}"/>
                                                    <Run Text="   ·   Venc.: "/>
                                                    <Run Text="{Binding SelectedDate, ElementName=DueDatePicker, StringFormat={}{0:dd.MM.yyyy}}"/>
                                                    <Run Text="   ·   Entrega: "/>
                                                    <Run Text="{Binding SelectedDate, ElementName=DeliveryDatePicker, StringFormat={}{0:dd.MM.yyyy}}"/>
                                                </TextBlock>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Moneda:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=CurrencyComboBox}"/>
                                            </Grid>

                                            <!-- Referencias clave -->
                                            <TextBlock Text="Referencias clave" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BT-10 (Buyer Ref.):" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=BuyerReferenceTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Concepto de pago:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=PaymentReferenceTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Proyecto / Contrato / Orden:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1">
                                                    <Run Text="{Binding Text, ElementName=ProjectNumberTextBox}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Text, ElementName=ContractNumberTextBox}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Text, ElementName=PurchaseOrderNumberTextBox}"/>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Líneas y totales -->
                                            <TextBlock Text="Líneas y totales" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nº de líneas:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Items.Count, ElementName=ProductsDataGrid}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Subtotal:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Text, ElementName=SubtotalTextBlock}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Impuestos (IVA):" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Text, ElementName=TaxesTextBlock}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Total a pagar:" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold"/>
                                                <TextBlock Grid.Column="1" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="{Binding Text, ElementName=TotalTextBlock}"/>
                                            </Grid>

                                            <!-- Impuestos -->
                                            <TextBlock Text="Impuestos" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Categoría:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=TaxCategoryComboBox}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Tasa:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=TaxRateTextBox}"/>
                                            </Grid>

                                            <!-- Pago -->
                                            <TextBlock Text="Pago" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="IBAN:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=IBANTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="BIC:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=BICTextBox}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Titular de cuenta:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=AccountNameTextBox}"/>
                                            </Grid>

                                            <!-- Entrega -->
                                            <TextBlock Text="Entrega" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Nombre:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Text, ElementName=ShipToNameTextBox}"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Ciudad / CP / País:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1">
                                                    <Run Text="{Binding Text, ElementName=ShipToCityNameTextBox}"/>
                                                    <Run Text="  ·  "/>
                                                    <Run Text="{Binding Text, ElementName=ShipToPostcodeCodeTextBox}"/>
                                                    <Run Text=", "/>
                                                    <Run Text="{Binding Text, ElementName=ShipToCountryIDTextBox}"/>
                                                </TextBlock>
                                            </Grid>

                                            <!-- Notas -->
                                            <TextBlock Text="Notas" FontSize="14" FontWeight="SemiBold" Margin="0,12,0,6" Foreground="{StaticResource PrimaryTextBrush}"/>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Generales:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=GeneralNoteTextBox}"/>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Términos de pago:" Foreground="{StaticResource SecondaryTextBrush}"/>
                                                <TextBlock Grid.Column="1" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding Text, ElementName=PaymentTermsDescriptionTextBox}"/>
                                            </Grid>

                                            <!-- Alertas (placeholder no intrusivo) -->
                                            <Border x:Name="SummaryAlertsPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="10" CornerRadius="6" Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource SystemFillColorAttentionBrush}" BorderThickness="1">
                                                <StackPanel>
                                                    <TextBlock Text="Revisa los campos pendientes" FontWeight="SemiBold"/>
                                                    <ItemsControl x:Name="SummaryAlertsItems"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Acciones -->
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                                <ui:Button x:Name="PreviewButton" Content="👁 Previsualizar"
                                                           Appearance="Secondary"
                                                           FontSize="14"
                                                           Padding="24,12"
                                                           Click="OnPreviewInvoiceClick"
                                                           Margin="0,0,14,0"/>
                                                <ui:Button x:Name="GenerateButton" Content="✓ Generar Factura"
                                                           Appearance="Success"
                                                           FontSize="14"
                                                           Padding="40,12"
                                                           Click="OnGenerateInvoiceClick"
                                                           Margin="0,0,20,0"/>
                                                <ui:Button Content="✕ Cancelar"
                                                           Appearance="Secondary"
                                                           FontSize="14"
                                                           Padding="40,12"
                                                           Click="OnCancelClick"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ui:Card>
                        </StackPanel>
                    </TabItem>
                </TabControl>
                <!-- END: Stepper (TabControl) -->

                <!-- Barra de navegación de pasos -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                    <TextBlock x:Name="ErrorCounterTextBlock" Text="" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <ui:Button x:Name="PrevStepButton" Content="← Atrás" Appearance="Secondary" Padding="28,10" Margin="0,0,10,0" Click="PrevStep_Click"/>
                    <ui:Button x:Name="NextStepButton" Content="Siguiente →" Appearance="Primary" Padding="28,10" Click="NextStep_Click"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
