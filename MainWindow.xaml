<Window x:Class="FacturacionAlemana.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FacturacionAlemana"
        mc:Ignorable="d"
        Title="Generador de Facturas" Height="450" Width="800">
    <Grid>
        <Button Content="Cargar XML" Width="150" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,20,0,0" Click="OnLoadXmlClick"/>
        <Button Content="Generar PDF" Width="150" Height="40" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,80,0,0" Click="OnGeneratePdfClick"/>
        <TextBlock x:Name="StatusText" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" FontSize="14" Foreground="Green"/>
    </Grid>
</Window>
