<Window x:Class="FacturacionAlemana.ProductDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Detalles del Producto" 
        Height="500" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ApplicationBackgroundBrush}"
        ResizeMode="NoResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Detalles Adicionales del Producto" FontSize="16" FontWeight="Bold" Margin="20,20,20,10" Grid.Row="0"/>
        
        <ScrollViewer VerticalScrollBarVisibility="Auto" Grid.Row="1" Margin="20,0,20,0">
            <StackPanel>
                <TextBlock Text="Nombre del Producto:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ui:TextBox x:Name="ProductNameTextBox" PlaceholderText="Nombre" Margin="0,0,0,15" IsReadOnly="True"/>

                <TextBlock Text="Descripción:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ui:TextBox x:Name="DescripcionTextBox" PlaceholderText="Descripción del producto" Margin="0,0,0,15" TextWrapping="Wrap" Height="60"/>

                <TextBlock Text="Período de Facturación" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Fecha Inicio:" VerticalAlignment="Center"/>
                    <DatePicker x:Name="BillingStartDatePicker" Grid.Column="1" Margin="10,0,0,0"/>
                    <TextBlock Text="Fecha Fin:" Grid.Row="1" VerticalAlignment="Center"/>
                    <DatePicker x:Name="BillingEndDatePicker" Grid.Row="1" Grid.Column="1" Margin="10,0,0,10"/>
                </Grid>

                <TextBlock Text="Códigos y Identificadores" FontWeight="SemiBold" Margin="0,0,0,10"/>
                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Código Vendedor:" VerticalAlignment="Center"/>
                    <ui:TextBox x:Name="SellerAssignedIDTextBox" Grid.Column="1" PlaceholderText="Ej: MICODIGO2" Margin="10,0,0,0"/>
                    <TextBlock Text="Código Comprador:" Grid.Row="1" VerticalAlignment="Center"/>
                    <ui:TextBox x:Name="BuyerAssignedIDTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Ej: CLIENTECODIGO2" Margin="10,0,0,10"/>
                    <TextBlock Text="Posición de Orden:" Grid.Row="2" VerticalAlignment="Center"/>
                    <ui:TextBox x:Name="BuyerOrderLineIDTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Ej: POSICIONORDEN2" Margin="10,0,0,10"/>
                </Grid>

                <TextBlock Text="Unidad de Medida:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                <ComboBox x:Name="UnitComboBox" Margin="0,0,0,20"/>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="20" Grid.Row="2">
            <ui:Button x:Name="OkButton" Content="✓ Aceptar" Appearance="Success" Padding="20,8" Click="OkButton_Click" Margin="0,0,10,0"/>
            <ui:Button x:Name="CancelButton" Content="✕ Cancelar" Appearance="Secondary" Padding="20,8" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
